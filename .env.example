# Copy to .env and fill in. NEVER commit .env.

# --- Mode ---------------------------------------------------------------------
# fake = simulated Devin sessions, free, no key needed (great for a first run)
# real = talk to the Devin API
DEVIN_MODE=fake

# --- Devin API (real mode) ------------------------------------------------------
DEVIN_API_KEY=
DEVIN_ORG_ID=
# DEVIN_API_BASE=https://api.devin.ai/v3

# --- GitHub -------------------------------------------------------------------
# Any random string. Use the same value when you register the webhook on the fork.
GITHUB_WEBHOOK_SECRET=change-me
TARGET_REPO=french-fries-and-sundaes/superset
# READY_LABEL=devin:ready
# PROPOSED_LABEL=devin:proposed

# --- Guards -------------------------------------------------------------------
# Rolling 24h cap on new Devin sessions (one session per task).
MAX_SESSIONS_PER_DAY=20
# Optional per-session cost cap enforced by Devin (leave empty for none).
MAX_ACU_PER_SESSION=

# --- Runtime ------------------------------------------------------------------
POLL_INTERVAL_SECONDS=15
DB_PATH=data/tasks.db
