# Copy to .env and fill in. NEVER commit .env.

# --- Mode ---------------------------------------------------------------------
# fake = simulated Devin sessions, free, no key needed (great for a first run)
# real = talk to the Devin API
DEVIN_MODE=fake

# --- Devin API (real mode) ------------------------------------------------------
DEVIN_API_KEY=
DEVIN_ORG_ID=
# DEVIN_API_BASE=https://api.devin.ai/v3

# --- GitHub -------------------------------------------------------------------
# Any random string. Use the same value when you register the webhook on the fork.
GITHUB_WEBHOOK_SECRET=change-me
# Fine-grained token for the fork AND the solution repo (see docs/GO_LIVE.md).
# Leave empty for DRY RUN: every GitHub write (labels, comments, issues) is logged, not sent.
GITHUB_TOKEN=
TARGET_REPO=french-fries-and-sundaes/superset
SOLUTION_REPO=french-fries-and-sundaes/superset-helper-eng
# READY_LABEL=devin:ready
# PROPOSED_LABEL=devin:proposed
# KNOWLEDGE_LABEL=devin:knowledge-base-improvement

# --- Verification -------------------------------------------------------------
# actions = hold a finished session until the devin-verify workflow on the fork reports
# off     = skip the gate (finished sessions go straight to in-review)
VERIFY_MODE=actions
# VERIFY_WORKFLOW_NAME=devin-verify

# --- Guards -------------------------------------------------------------------
# Rolling 24h cap on new Devin sessions (fix + scan + learn count).
MAX_SESSIONS_PER_DAY=20
# Optional per-session cost cap enforced by Devin (leave empty for none).
MAX_ACU_PER_SESSION=
# At most this many findings are filed per sweep.
SCAN_MAX_FINDINGS=7

# --- Dashboard ----------------------------------------------------------------
# If set, the dashboard, JSON API, and the Run scan / Run learn buttons need this password
# (HTTP Basic auth, any username). SET THIS whenever the port is reachable from a tunnel.
DASHBOARD_PASSWORD=

# --- Safety -------------------------------------------------------------------
# The bot refuses to start if the database was created in a different DEVIN_MODE (simulated tasks must
# never mix with real ones), or if DEVIN_MODE=fake is combined with a GITHUB_TOKEN. Leave this unset.
# ALLOW_MODE_CHANGE=1

# --- Runtime ------------------------------------------------------------------
POLL_INTERVAL_SECONDS=15
DB_PATH=data/tasks.db
